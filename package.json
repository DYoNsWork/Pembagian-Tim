{
  "name": "pembagian-tim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && node scripts/sync-d1.mjs && wrangler deploy",
    "versions-upload": "npm run build && node scripts/sync-d1.mjs && wrangler versions upload",
    "db:migrate:local": "wrangler d1 migrations apply pembagian-tim-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pembagian-tim-db --remote",
    "setup:d1": "node scripts/setup-d1.mjs",
    "postinstall": "node scripts/ci-postinstall.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.16",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
